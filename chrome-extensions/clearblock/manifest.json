{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Clearblock",
  "version": "1.3.2",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clearblock",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube",
        "enabled": true,
        "path": "rules/dnr-youtube.json"
      },
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/dnr-ads.json"
      },
      {
        "id": "allow",
        "enabled": true,
        "path": "rules/dnr-allow.json"
      },
      {
        "id": "media",
        "enabled": true,
        "path": "rules/dnr-media.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["rules/cosmetic-generic.css", "rules/cosmetic-specific.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/shared.js", "src/cosmetic.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/page-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.youtu.be/*",
        "http://127.0.0.1:43180/test/lab/youtube.html",
        "http://127.0.0.1:43180/test/youtube-player-lab.html"
      ],
      "js": ["src/shared.js", "src/youtube-isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.youtu.be/*",
        "http://127.0.0.1:43180/test/lab/youtube.html",
        "http://127.0.0.1:43180/test/youtube-player-lab.html"
      ],
      "js": ["src/youtube-prune.js", "src/youtube-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
